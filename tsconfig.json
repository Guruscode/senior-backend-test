{
  "compilerOptions": {
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "types": ["jest", "node", "express"],
    "baseUrl": "./",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true
  },
  "include": ["src/**/*.ts", "src/types/**/*.d.ts"]
}
